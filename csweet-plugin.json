{
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "manager.v1",
    "declaredRoleKeys": ["software-product-manager"],
    "specializationKeys": ["product-strategy", "software-delivery"]
  },
  "id": "com.csweet.product-manager",
  "name": "C-Sweet Software Product Manager",
  "version": "2.12.0",
  "publisher": {
    "id": "com.csweet",
    "name": "C-Sweet"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agent.SoftwareProductManager/CSweet.Agent.SoftwareProductManager.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "AlwaysOn",
    "defaultTickFrequencySeconds": 300,
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": {
    "minimumVersion": "2.0",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "assistant.converse.v1",
      "description": "Converse with the Software Product Manager.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "assistant.summarize-activity.v1",
      "description": "Summarize product activity.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "assistant.plan-work.v1",
      "description": "Plan product work.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "management.check-in.v1",
      "description": "Run a Software Product Manager check-in.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycleId", "checkInType", "periodStart", "periodEnd", "workstreamIds", "topics", "dueAt"],
        "properties": {
          "cycleId": { "type": "string", "format": "uuid" },
          "checkInType": { "type": "string" },
          "periodStart": { "type": "string", "format": "date-time" },
          "periodEnd": { "type": "string", "format": "date-time" },
          "workstreamIds": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dueAt": { "type": "string", "format": "date-time" },
          "requestId": { "type": ["string", "null"], "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycleId", "summary", "completedOutcomes", "inProgress", "blockers", "risks",
          "resourceNeeds", "decisionsNeeded", "assumptions", "confidence", "reportedAt",
          "immediateActions", "conversationTopics", "severity"
        ],
        "properties": {
          "cycleId": { "type": "string", "format": "uuid" },
          "summary": { "type": "string" },
          "completedOutcomes": { "type": "array", "items": { "type": "string" } },
          "inProgress": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "resourceNeeds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability", "businessOutcome", "urgency", "evidence", "consequenceIfUnfilled"],
              "properties": {
                "capability": { "type": "string" },
                "businessOutcome": { "type": "string" },
                "urgency": { "type": "string" },
                "evidence": { "type": "string" },
                "consequenceIfUnfilled": { "type": "string" },
                "estimatedCost": { "type": ["number", "null"] },
                "currency": { "type": ["string", "null"] }
              }
            }
          },
          "decisionsNeeded": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" },
          "reportedAt": { "type": "string", "format": "date-time" },
          "requestId": { "type": ["string", "null"], "format": "uuid" },
          "markdown": { "type": ["string", "null"] },
          "immediateActions": { "type": "array", "items": { "type": "string" } },
          "conversationTopics": { "type": "array", "items": { "type": "string" } },
          "severity": { "type": "string" }
        }
      },
      "executionTimeoutSeconds": 60,
      "idempotency": "work-item"
    },
    {
      "name": "product-management.plan.v1",
      "description": "Create a product-management plan.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleBrief", "focus", "sourceEventId", "idempotencyKey"],
        "properties": {
          "roleBrief": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status", "chiefOrganizationUserId", "productManagerOrganizationUserId",
              "contextRevision", "mandate", "productOutcomes", "successMeasures",
              "constraints", "decisionRights", "knownTeam", "missingInformation", "preparedAt"
            ],
            "properties": {
              "status": { "type": "string" },
              "chiefOrganizationUserId": { "type": "string", "format": "uuid" },
              "productManagerOrganizationUserId": { "type": "string", "format": "uuid" },
              "contextRevision": { "type": "integer" },
              "mandate": { "type": "string" },
              "productOutcomes": { "type": "array", "items": { "type": "string" } },
              "successMeasures": { "type": "array", "items": { "type": "string" } },
              "constraints": { "type": "array", "items": { "type": "string" } },
              "decisionRights": { "type": "array", "items": { "type": "string" } },
              "knownTeam": { "type": "array", "items": { "type": "string" } },
              "missingInformation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "question", "whyItMatters"],
                  "properties": {
                    "key": { "type": "string" },
                    "question": { "type": "string" },
                    "whyItMatters": { "type": "string" }
                  }
                }
              },
              "preparedAt": { "type": "string", "format": "date-time" }
            }
          },
          "focus": { "type": "string" },
          "sourceEventId": { "type": "string", "format": "uuid" },
          "idempotencyKey": { "type": "string", "minLength": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation", "productStrategy", "roadmapThemes", "teamStructure",
          "hiringSequence", "alternatives", "risks", "assumptions", "executiveDecisions",
          "contextRevision", "preparedAt"
        ],
        "properties": {
          "recommendation": { "type": "string" },
          "productStrategy": { "type": "array", "items": { "type": "string" } },
          "roadmapThemes": { "type": "array", "items": { "type": "string" } },
          "teamStructure": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "purpose", "reportsTo", "timing", "priority"],
              "properties": {
                "title": { "type": "string" },
                "purpose": { "type": "string" },
                "reportsTo": { "type": "string" },
                "timing": { "type": "string" },
                "priority": { "type": "integer" }
              }
            }
          },
          "hiringSequence": { "type": "array", "items": { "type": "string" } },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "tradeoff", "teamStructure"],
              "properties": {
                "name": { "type": "string" },
                "tradeoff": { "type": "string" },
                "teamStructure": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "purpose", "reportsTo", "timing", "priority"],
                    "properties": {
                      "title": { "type": "string" },
                      "purpose": { "type": "string" },
                      "reportsTo": { "type": "string" },
                      "timing": { "type": "string" },
                      "priority": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "risks": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "executiveDecisions": { "type": "array", "items": { "type": "string" } },
          "contextRevision": { "type": "integer" },
          "preparedAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 60,
      "idempotency": "work-item"
    },
    {
      "name": "product-management.context.update.v1",
      "description": "Update Software Product Manager context and submit a refreshed team plan when ready.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleBrief", "sourceEventId", "idempotencyKey"],
        "properties": {
          "roleBrief": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status", "chiefOrganizationUserId", "productManagerOrganizationUserId",
              "contextRevision", "mandate", "productOutcomes", "successMeasures",
              "constraints", "decisionRights", "knownTeam", "missingInformation", "preparedAt"
            ],
            "properties": {
              "status": { "type": "string" },
              "chiefOrganizationUserId": { "type": "string", "format": "uuid" },
              "productManagerOrganizationUserId": { "type": "string", "format": "uuid" },
              "contextRevision": { "type": "integer" },
              "mandate": { "type": "string" },
              "productOutcomes": { "type": "array", "items": { "type": "string" } },
              "successMeasures": { "type": "array", "items": { "type": "string" } },
              "constraints": { "type": "array", "items": { "type": "string" } },
              "decisionRights": { "type": "array", "items": { "type": "string" } },
              "knownTeam": { "type": "array", "items": { "type": "string" } },
              "missingInformation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "question", "whyItMatters"],
                  "properties": {
                    "key": { "type": "string" },
                    "question": { "type": "string" },
                    "whyItMatters": { "type": "string" }
                  }
                }
              },
              "preparedAt": { "type": "string", "format": "date-time" }
            }
          },
          "sourceEventId": { "type": "string", "format": "uuid" },
          "idempotencyKey": { "type": "string", "minLength": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acknowledged", "state", "planRefreshRequired", "materialChanges", "acknowledgedAt"],
        "properties": {
          "acknowledged": { "type": "boolean" },
          "state": { "type": "string" },
          "planRefreshRequired": { "type": "boolean" },
          "materialChanges": { "type": "array", "items": { "type": "string" } },
          "acknowledgedAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 60,
      "idempotency": "work-item"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Software Product Manager configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "agentVersion", "schemaVersion", "fields", "settings"],
        "properties": {
          "agentId": { "type": "string" },
          "agentVersion": { "type": "string" },
          "schemaVersion": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "type", "required"],
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": ["string", "null"] },
                "placeholder": { "type": ["string", "null"] },
                "options": {
                  "type": ["array", "null"],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["value", "label"],
                    "properties": {
                      "value": { "type": "string" },
                      "label": { "type": "string" }
                    }
                  }
                },
                "minimum": { "type": ["number", "null"] },
                "maximum": { "type": ["number", "null"] },
                "step": { "type": ["number", "null"] },
                "dependsOnFieldKey": { "type": ["string", "null"] }
              }
            }
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": { "type": "string" },
              "llmModel": { "type": "string" },
              "responseTone": { "type": "string" }
            }
          }
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Software Product Manager configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["settings"],
        "properties": {
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": { "type": "string" },
              "llmModel": { "type": "string" },
              "responseTone": { "type": "string", "enum": ["concise", "balanced", "detailed"] }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["succeeded", "settings"],
        "properties": {
          "succeeded": { "type": "boolean" },
          "message": { "type": ["string", "null"] },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": { "type": "string" },
              "llmModel": { "type": "string" },
              "responseTone": { "type": "string" }
            }
          }
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item"
    }
  ],
  "requires": [
    { "name": "work.personal-todo.read.v1", "scope": "organization", "purpose": "Read resource-scoped personal queues" },
    { "name": "work.personal-todo.add.v1", "scope": "organization", "purpose": "Add self or direct-report personal work" },
    { "name": "work.personal-todo.reorder.v1", "scope": "organization", "purpose": "Reorder directly managed personal work" },
    { "name": "work.personal-todo.requeue.v1", "scope": "organization", "purpose": "Requeue blocked or waiting personal work when authoritative state makes it actionable" },
    { "name": "work.personal-todo.claim.v1", "scope": "organization", "purpose": "SDK-managed atomic personal work claims" },
    { "name": "work.personal-todo.complete.v1", "scope": "organization", "purpose": "SDK-managed personal work completion" },
    { "name": "work.personal-todo.block.v1", "scope": "organization", "purpose": "SDK-managed durable personal work blocking" },
    { "name": "work.personal-todo.release.v1", "scope": "organization", "purpose": "SDK-managed personal work release" },
    { "name": "work.personal-todo.defer.v1", "scope": "organization", "purpose": "Durably wait until the next natural review without visible chatter" },
    {
      "name": "platform.team-roster.read.v1",
      "scope": "team",
      "purpose": "Read only this Software Product Manager employee's approved team roster and team-specific roles"
    },
    { "name": "platform.user-input.request.v1", "scope": "organization", "purpose": "Ask the owner one bounded structured product question" },
    { "name": "platform.llm.chat-stream.v1", "scope": "organization", "purpose": "Generate Software Product Manager responses" },
    { "name": "platform.business-profile.read.v1", "scope": "organization", "purpose": "Ground advice in the authoritative business profile" },
    { "name": "platform.business-profile.propose-update.v1", "scope": "organization", "purpose": "Propose sensitive or inferred business profile changes" },
    { "name": "platform.organization.snapshot.read.v1", "scope": "organization", "purpose": "Inspect reporting lines, workstreams, roles, and available workers" },
    { "name": "platform.business-pattern.search.v1", "scope": "organization", "purpose": "Find stage-appropriate operating patterns" },
    { "name": "platform.finance-profile.read.v1", "scope": "organization", "purpose": "Ground staffing advice and revisions in financial controls" },
    { "name": "platform.management-cycle.read.v1", "scope": "organization", "purpose": "Follow the configured management cadence" },
    { "name": "memory.business.read.v1", "scope": "organization", "purpose": "Recall approved organization-wide business and product context" },
    { "name": "memory.user.read.v1", "scope": "user", "purpose": "Recall approved user context" },
    { "name": "memory.user.propose.v1", "scope": "user", "purpose": "Propose user memories" },
    { "name": "communication.chat.read.v1", "scope": "team", "purpose": "Read broker-authorized manager and team planning conversations" },
    { "name": "agent.onboarding.complete.v1", "scope": "organization", "purpose": "Acknowledge completion of this installation's durable onboarding event" },
    { "name": "communication.chat.create.v1", "scope": "team", "purpose": "Open or reuse a direct PM-Architect planning conversation" },
    { "name": "communication.chat.modify.v1", "scope": "team", "purpose": "Reconcile an authorized private team conversation" },
    { "name": "communication.message.send.v1", "scope": "team", "purpose": "Coordinate product decisions and planning revisions with authorized team members" },
    { "name": "communication.coordination.start.v1", "scope": "team", "purpose": "Start the one durable PM-Architect planning collaboration" },
    { "name": "communication.coordination.respond.v1", "scope": "team", "purpose": "Submit one structured product collaboration disposition" },
    { "name": "communication.coordination.read.v1", "scope": "team", "purpose": "Read the PM-Architect collaboration session" },
    { "name": "communication.coordination.list.v1", "scope": "team", "purpose": "List the Product Manager's own planning sessions for deterministic recovery" },
    { "name": "communication.coordination.resume.v1", "scope": "team", "purpose": "Resume a failed Product Manager-initiated planning session" },
    { "name": "communication.coordination.cancel.v1", "scope": "team", "purpose": "Stop an authorized PM-Architect collaboration" },
    { "name": "platform.management.resource-change.propose.v1", "scope": "organization", "purpose": "Propose one atomic desired-team snapshot to the current manager", "modelVisible": false },
    { "name": "platform.management.resource-change.read.v1", "scope": "organization", "purpose": "Read the Software Product Manager's resource-change requests and decisions" },
    { "name": "platform.management.staffing-replenishment.propose.v1", "scope": "team", "purpose": "Propose one deduplicated governed replacement plan when approved viable capacity is lost" },
    { "name": "platform.management.staffing-replenishment.read.v1", "scope": "team", "purpose": "Reconcile replacement requests and manager decisions" },
    { "name": "platform.agent-operating-state.read.v1", "scope": "organization", "purpose": "Read the previous typed PM assessment checkpoint" },
    { "name": "platform.agent-operating-state.write.v1", "scope": "organization", "purpose": "Persist a revision-safe typed PM assessment after authoritative reconciliation" },
    { "name": "work.board.create", "scope": "team", "purpose": "Create one software-team kanban board after manager approval", "modelVisible": false },
    { "name": "work.board.read", "scope": "team", "purpose": "Read the approved software team's board and exact workflow columns" },
    { "name": "work.board.configure", "scope": "team", "purpose": "Set or correct the concise outcome-focused name of the Product Manager's board", "modelVisible": false },
    { "name": "work.board.columns.configure", "scope": "team", "purpose": "Configure the approved software team's seven-column workflow", "modelVisible": false },
    { "name": "work.item.read", "scope": "team", "purpose": "Read published sprint tickets before revision-safe readiness moves" },
    { "name": "work.item.create", "scope": "team", "purpose": "Create idempotent decision-ready planning tickets during approved agent collaboration" },
    { "name": "work.item.comment", "scope": "team", "purpose": "Record authoritative product-context decisions on affected planning tickets" },
